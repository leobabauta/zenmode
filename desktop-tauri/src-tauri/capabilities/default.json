{
  "identifier": "default",
  "description": "Default permissions for zenmode desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "updater:default",
    "dialog:default",
    "process:allow-restart"
  ]
}
